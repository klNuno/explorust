<?xml version="1.0" encoding="utf-8"?>
<!-- Sparse package that gives explorust-notify.exe package identity, so that
     UserNotificationListener.NotificationChanged works (step notify-4). Unsigned: the publisher
     carries the OID Windows 11 accepts for unsigned packages. Built by make-msix.py, installed with
     Add-AppxPackage -Path explorust-notify.msix -ExternalLocation C:\explorust -AllowUnsigned. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 rescap">
  <Identity Name="explorust.notify" Publisher="CN=explorust, OID.2.25.311729368913984317654407730594956997722=1" Version="1.0.0.0" ProcessorArchitecture="x64"/>
  <Properties>
    <DisplayName>explorust notifications</DisplayName>
    <PublisherDisplayName>explorust</PublisherDisplayName>
    <Logo>logo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="en-us"/>
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26300.0"/>
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
    <uap3:Capability Name="userNotificationListener"/>
  </Capabilities>
  <Applications>
    <Application Id="notify" Executable="explorust-notify.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none" DisplayName="explorust notifications" Description="explorust notification listener"
        BackgroundColor="transparent" Square150x150Logo="logo.png" Square44x44Logo="logo.png"/>
    </Application>
  </Applications>
</Package>
